rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Cada usuario solo lee y escribe su propio documento
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Lista de estudiantes del maestro — solo el propio maestro
    match /teachers/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Notas del maestro al estudiante
    // Lectura libre (el estudiante accede con su código sin login)
    // Escritura solo para maestros autenticados
    match /notes/{studentCode}/messages/{msgId} {
      allow read: if true;
      allow write: if request.auth != null;
      allow delete: if request.auth != null;
    }

    // Plan de clase
    // Lectura libre (el estudiante lo ve sin login)
    // Escritura solo para maestros autenticados
    match /classPlan/{studentCode} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
